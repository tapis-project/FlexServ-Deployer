# Copy to site.env, edit shared paths, then source it in the allocation shell.
# These must be Linux release builds visible at the same paths on every node.
export BOOTSTRAP_BIN=/shared/flexserv/FlexServ/flexserv/bootstrap/target/release/flexserv-bootstrap
export GATEWAY_BIN=/shared/flexserv/FlexServ/flexserv/gateway/target/release/flexserv-gateway
export FCS_BIN=/shared/flexserv/fcs-deploy-node-v013/target/release/mcp-bashkit-server
export FCS_PACK=/shared/flexserv/fcs-deploy-node-v013/examples/vllm-pack/payload

# Supply a real host policy for your site; its principal must match MCP_PRINCIPAL.
export FCS_DEPLOY_POLICY=/shared/flexserv/site/deploy-policy.yaml
export MCP_PRINCIPAL=hpc-user
export GATEWAY_PORT=8000
export GATEWAY_BIND_HOST=0.0.0.0
export RUN_SECONDS=3600
export FCS_CPUS_PER_TASK=1

# HOME must be shared across allocated nodes, or override this with a private,
# shared directory whose ancestry passes Bootstrap's protected-path checks.
export STATE_ROOT="$HOME/.local/state/flexserv/slurm-${SLURM_JOB_ID:?Allocate nodes first}"

# Optional: pin an inventory reviewed in advance instead of approving its current bytes.
# export FCS_PACK_SHA256=...
# export FCS_CONNECTIONS=/shared/flexserv/site/connections.yaml
# export FCS_WORKFLOW_POLICY=/shared/flexserv/site/workflow-policy.yaml
# export GATEWAY_ROUTING_POLICY=/shared/flexserv/site/routing.json
# export PUB_MODEL_REPO=/shared/models/public
# export PRI_MODEL_REPO=/shared/models/private
# export STARTUP_TIMEOUT_SECONDS=120
# export MCP_ALLOWED_TOOLS="io.flexserv.deployments.inspect io.flexserv.deployments.status"

# Set FCS_MCP_TOKEN and FLEXSERV_ADMIN_SECRET interactively, as shown in README.md.
# Optional inference authentication uses a separate FLEXSERV_TOKEN environment value.
