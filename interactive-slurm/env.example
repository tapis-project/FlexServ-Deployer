# Copy to site.env, edit shared paths, then source it in the allocation shell.
# These must be Linux release builds visible at the same paths on every node.

export FLEXSERV_PAR_DIR=/home1/10899/wzhang217/software/FlexServ_150
export BOOTSTRAP_BIN=$FLEXSERV_PAR_DIR/FlexServ/flexserv/bootstrap/target/release/flexserv-bootstrap
export GATEWAY_BIN=$FLEXSERV_PAR_DIR/FlexServ/flexserv/gateway/target/release/flexserv-gateway
export FCS_BIN=$FLEXSERV_PAR_DIR/FlexServ-FCS/target/release/mcp-bashkit-server
export FCS_PACK=$FLEXSERV_PAR_DIR/FlexServ-FCS/examples/vllm-pack/payload

# Optional for control-plane startup/discovery. Enable only after generating and
# reviewing a real host deployment policy; see README.md, "Deployment policy".
# export FCS_DEPLOY_POLICY=$FLEXSERV_PAR_DIR/site/deployment.yaml
export MCP_PRINCIPAL=wzhang217
export GATEWAY_PORT=8000
export GATEWAY_BIND_HOST=0.0.0.0
export RUN_SECONDS=3600
export FCS_CPUS_PER_TASK=1

# HOME must be shared across allocated nodes, or override this with a private,
# shared directory whose ancestry passes Bootstrap's protected-path checks.
export STATE_ROOT="$HOME/.local/state/flexserv/slurm-${SLURM_JOB_ID:?Allocate nodes first}"

# Optional: pin an inventory reviewed in advance instead of approving its current bytes.
# export FCS_PACK_SHA256=...
# Enable optional site files/model directories only after preparing them.
# export FCS_CONNECTIONS=$FLEXSERV_PAR_DIR/site/connections.yaml
# export FCS_WORKFLOW_POLICY=$FLEXSERV_PAR_DIR/site/workflow-policy.yaml
# export GATEWAY_ROUTING_POLICY=$FLEXSERV_PAR_DIR/site/routing.json
# export PUB_MODEL_REPO=$FLEXSERV_PAR_DIR/models/public
# export PRI_MODEL_REPO=$FLEXSERV_PAR_DIR/models/private
export STARTUP_TIMEOUT_SECONDS=120
export MCP_ALLOWED_TOOLS="io.flexserv.deployments.inspect io.flexserv.deployments.status"

# Set FCS_MCP_TOKEN and FLEXSERV_ADMIN_SECRET interactively, as shown in README.md.
# Optional inference authentication uses a separate FLEXSERV_TOKEN environment value.
