# Deployment configuration only. Put credentials in the caller's environment.
export HOST_TYPE=${HOST_TYPE:-$(get_host_type)}
export SLURM_JOB_PARTITION=${SLURM_JOB_PARTITION:-${SLURM_JOB_PARTITION_NAME:-}}
if [[ -z "$SLURM_JOB_PARTITION" ]]; then
    SLURM_JOB_PARTITION=$(scontrol show job -o "$SLURM_JOB_ID" | tr ' ' '\n' | sed -n 's/^Partition=//p')
    export SLURM_JOB_PARTITION
fi
[[ -n "$SLURM_JOB_PARTITION" ]] || { echo 'Cannot determine Slurm partition.' >&2; return 1; }
export HARDWARE_ENV=${HARDWARE_ENV:-${HOST_TYPE}-${SLURM_JOB_PARTITION}}
[[ "$HARDWARE_ENV" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] || { echo 'Invalid HARDWARE_ENV.' >&2; return 1; }
export FLEXSERV_VENV_ROOT=${FLEXSERV_VENV_ROOT:-$(get_flexserv_venv_root)}
export FLEXSERV_VENV_PYTHON_INSTALL_DIR=${FLEXSERV_VENV_PYTHON_INSTALL_DIR:-$FLEXSERV_VENV_ROOT/python/$HARDWARE_ENV}
export FLEXSERV_VLLM_VENV_PATH=${FLEXSERV_VLLM_VENV_PATH:-$FLEXSERV_VENV_ROOT/vllm-venv-$HARDWARE_ENV}
export FLEXSERV_MAX_VENV_ROOT=${FLEXSERV_MAX_VENV_ROOT:-$FLEXSERV_VENV_ROOT/modular-max-$HARDWARE_ENV}
export FLEXSERV_MAX_VENV_PATH=${FLEXSERV_MAX_VENV_PATH:-$FLEXSERV_MAX_VENV_ROOT/.venv}
export FLEXSERV_PREPARE_BACKENDS=${FLEXSERV_PREPARE_BACKENDS:-1}
export FLEXSERV_INSTALL_MAX=${FLEXSERV_INSTALL_MAX:-auto}
export LOCAL_PORT=${LOCAL_PORT:-8000}
# Only the parsed CLI flag enables public TLS; internal mutual TLS is independent.
export ENABLE_HTTPS=${ENABLE_HTTPS:-0}
export FLEXSERV_TRUST_REMOTE_CODE=${FLEXSERV_TRUST_REMOTE_CODE:-false}
export PRI_MODEL_REPO=${PRI_MODEL_REPO:-$FLEXSERV_JOB_DIR/runtime/private-models}
export PUB_MODEL_REPO=${PUB_MODEL_REPO:-$FLEXSERV_JOB_DIR/runtime/public-models}
export FLEXSERV_SERVICE_PORT_START=${FLEXSERV_SERVICE_PORT_START:-18000}
export FLEXSERV_SERVICE_PORT_END=${FLEXSERV_SERVICE_PORT_END:-18100}
export GATEWAY_BIND_HOST=${GATEWAY_BIND_HOST:-0.0.0.0}
export STARTUP_TIMEOUT_SECONDS=${STARTUP_TIMEOUT_SECONDS:-120}
export FCS_CPUS_PER_TASK=${FCS_CPUS_PER_TASK:-1}
export MCP_PRINCIPAL=${MCP_PRINCIPAL:-${USER:?USER is required}}
export NODE_HOSTNAME_DOMAIN=${NODE_HOSTNAME_DOMAIN:-$(hostname -f)}
